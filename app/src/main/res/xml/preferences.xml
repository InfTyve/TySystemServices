<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        顶部品牌 Logo：不做成可点击项，只借 Preference 的自定义布局能力占一行。
        layout = hua_logoi（背景 harmonyos_logo_bg + 居中 emui_brand_logo + 圆角）
    -->
    <androidx.preference.Preference
        android:key="hua_logo_header"
        android:layout="@layout/hua_logoi"
        android:persistent="false"
        android:selectable="false" />

    <androidx.preference.PreferenceCategory
        android:key="category_personalization"
        android:title="@string/pref_category_personalization">

        <com.android.ty.systemservices.compose.ui.preference.ComposeSwitchPreference
            android:key="use_blur"
            android:title="@string/pref_use_blur_title"
            android:summary="@string/pref_use_blur_summary"
            android:defaultValue="false" />

        <com.android.ty.systemservices.compose.ui.preference.ComposeSwitchPreferenceClock
            android:key="secure_mode"
            android:title="@string/secure_mode"
            android:summary="@string/secure_mode_desc"
            android:defaultValue="false" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="category_general"
        android:title="@string/pref_category_general">

        <com.android.ty.systemservices.compose.ui.preference.ComposeListPreference
            android:key="reply_action"
            android:title="@string/pref_reply_action_title"
            android:entries="@array/reply_entries"
            android:entryValues="@array/reply_values"
            android:defaultValue="reply" />

        <com.android.ty.systemservices.compose.ui.preference.ComposeEditPreference
            android:key="signature"
            android:title="@string/pref_signature_title"
            android:dialogTitle="@string/pref_signature_title"
            android:summary="%s" />

        <com.android.ty.systemservices.compose.ui.preference.ComposeDropDownMenuPreference
            android:key="resolution"
            android:title="@string/pref_resolution_title"
            android:summary="@string/pref_resolution_summary"
            android:entries="@array/lll"
            android:entryValues="@array/lll"
            android:defaultValue="001" />
        <com.android.ty.systemservices.compose.ui.preference.ComposePreference
            android:key="about"
            android:title="@string/pref_about_title"
            android:summary="@string/pref_about_summary" />

        <!-- 多选示例：点击由 ComposeMultiSelectListPreferenceDialogFragment 弹出 Compose 多选面板 -->
        <com.android.ty.systemservices.compose.ui.preference.ComposeMultiSelectListPreference
            android:key="multi_select_demo"
            android:title="@string/pref_multi_select_title"
            android:summary="@string/pref_multi_select_summary"
            app:iconDrawable="@drawable/ic_settings_24dp"
            android:entries="@array/demo_multi_entries"
            android:entryValues="@array/demo_multi_values" />
    </androidx.preference.PreferenceCategory>

    <!-- 可展开卡片：头部文字取 android:title / android:summary，
         展开后的文字取 app:otitle / app:osummary -->
    <androidx.preference.PreferenceCategory
        android:key="category_advanced"
        android:title="@string/pref_category_advanced">

        <com.android.ty.systemservices.compose.ui.preference.ExpandableCardPreference
            android:key="pref_expandable"
            android:title="@string/advanced_options"
            android:summary="@string/advanced_options_hint"
            app:iconDrawable="@drawable/ic_settings_24dp"
            app:otitle="@string/expanded_item"
            app:osummary="@string/expanded_item_desc" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
