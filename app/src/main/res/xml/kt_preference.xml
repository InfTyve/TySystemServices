<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.PreferenceCategory
        android:key="category_general"
        android:title="@string/pref_category_general">

        <com.android.ty.systemservices.compose.CardNavigationPreference
            android:key="pref_clear_cache"
            android:summary="@string/kt_clear_cache_summary"
            android:title="@string/kt_clear_cache_title" />

        <com.android.ty.systemservices.compose.CardNavigationPreference
            android:key="pref_about"
            android:summary="@string/pref_about_summary"
            android:title="@string/pref_about_title" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="category_developer"
        android:title="@string/kt_category_developer">

        <com.android.ty.systemservices.compose.MD3SwitchPreference
            android:defaultValue="false"
            android:key="pref_experimental"
            android:title="@string/kt_experimental_title" />

        <com.android.ty.systemservices.compose.MD3SwitchPreference
            android:defaultValue="false"
            android:key="pref_dev_mode"
            android:title="@string/kt_dev_mode_title" />

        <com.android.ty.systemservices.compose.ui.preference.ExpandableCardPreference
            android:key="pref_expandable"
            android:title="@string/kt_expandable_title"
            android:summary="@string/advanced_options_hint"
            app:otitle="@string/kt_expandable_content_title"
            app:osummary="@string/kt_expandable_content_summary" />

        <com.android.ty.systemservices.compose.ui.preference.ComposeMultiSelectListPreference
            android:key="pref_multi_select"
            android:title="@string/pref_multi_select_title"
            android:summary="@string/pref_multi_select_summary"
            android:entries="@array/demo_multi_entries"
            android:entryValues="@array/demo_multi_values" />

    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>
