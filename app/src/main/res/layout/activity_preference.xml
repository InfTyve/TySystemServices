<?xml version="1.0" encoding="utf-8"?>
<!--
    大标题基类布局（Preference / One：SCALE 折叠）：
    头部整块由 Compose 绘制（header_compose），这里只保留滚动物理。

    minHeight = 折叠后剩下的顶栏高度：AppBarLayout 的 getTotalScrollRange()
    会把子 View 的 minimumHeight 减掉，所以收起后恰好剩 56dp，不依赖 CollapsingToolbarLayout。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:fitsSystemWindows="true">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/header_compose"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:minHeight="56dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 内容真正放这里（首页会替换成一个 Fragment 或 ComposeView） -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
